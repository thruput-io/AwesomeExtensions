<idea-plugin>
  <id>se.thruput.awesomeextensions</id>
  <name>AwesomeExtensions</name>
  <version>1.0.0</version>
  <vendor url="https://project-url">Thruput</vendor>
  <idea-version since-build="2025.3.0"  />
  <depends>com.intellij.modules.rider</depends>

  <description>
<![CDATA[
<p>Adds the missing extensions to Rider</p>
<ul>
<li>Generate Extension Method</li>
</ul>
]]>
  </description>

  <extensions defaultExtensionNs="com.intellij">
    <rider.backend.module id="AwesomeExtensions"
                          title="AwesomeExtensions"
                          description="AwesomeExtensions"
                          assembly="AwesomeExtensions.dll" />
    <rider.model.extensionRoot implementation="model.rider.AwesomeExtensionsRoot" />
  </extensions>

</idea-plugin>
