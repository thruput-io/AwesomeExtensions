<idea-plugin require-restart="true">
  <id>se.thruput.awesomeextensions</id>
  <name>AwesomeExtensions</name>
  <version>0.0.4</version>
  <vendor url="https://project-url">Thruput</vendor>
  <idea-version since-build="2025.1.0"  />
  <depends>com.intellij.modules.rider</depends>

  <description>
<![CDATA[
<p>Adds the missing extensions to Rider</p>
]]>
  </description>

  <extensions defaultExtensionNs="com.intellij">
    <contextAction implementationClass="GenerateExtensionMethodAction"
                   text="Generate Extension Method"
                   description="Generates an extension method for the selected type."
                   group="CSharp"/>
  </extensions>

</idea-plugin>
